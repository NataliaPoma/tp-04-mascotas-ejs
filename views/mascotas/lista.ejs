<main class="contenedor">
  <div class="cabecera-pagina">
    <h1>Catálogo de Mascotas</h1>
    <a href="/mascotas/nueva" class="boton">Agregar mascota</a>
  </div>

  <% if (mascotas.length === 0) { %>
    <section class="estado">
      <h2>No hay mascotas disponibles</h2>
      <p>Por el momento no tenemos mascotas registradas para adopción.</p>
    </section>
  <% } else { %>
    <section class="grilla">
      <% mascotas.forEach(mascota => { %>
        <article class="tarjeta">
          <img src="<%= mascota.imagen %>" alt="Imagen de <%= mascota.nombre %>">
          <h2><%= mascota.nombre %></h2>
          <p><strong>Especie:</strong> <%= mascota.especie %></p>
          <p><strong>Edad:</strong> <%= mascota.edad %> años</p>
          <p><strong>Estado:</strong> <%= mascota.estado %></p>
          <p><%= mascota.descripcion %></p>
          <a href="/mascotas/<%= mascota.id %>" class="boton">Ver detalle</a>
        </article>
      <% }) %>
    </section>
  <% } %>
</main>
